{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CUE",
  "version": "0.1.1",
  "identifier": "app.cue.dictation",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' blob:; style-src 'self'; style-src-attr 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "seymurglv",
    "copyright": "Copyright 2026 seymurglv",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../ui/src/design/fonts/OFL.txt": "OFL.txt",
      "../ui/src/design/fonts/OFL-Montserrat.txt": "OFL-Montserrat.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English", "Russian"],
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
